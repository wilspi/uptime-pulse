{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "uptime-pulse",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "uptime-pulse",
			"migrations_dir": "./migrations"
		}
	],
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"secrets": {
		"required": [
			"SITE_NAME",
			"SMTP_HOST",
			"SMTP_PORT",
			"SMTP_FROM",
			"SMTP_TO",
			"ADMIN_TOKEN",
			"SMTP_USERNAME",
			"SMTP_PASSWORD"
		]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	}
}
